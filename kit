#!/usr/bin/env php
<?php

define('KIT_ROOT', __DIR__);

// ── Load .env ─────────────────────────────────────────────────
$envFile = KIT_ROOT . '/.env';
if (file_exists($envFile)) {
    $env = parse_ini_file($envFile);
    if ($env) foreach ($env as $k => $v) $_ENV[$k] = $v;
}

require_once KIT_ROOT . '/app/config/app.php';
require_once KIT_ROOT . '/app/config/database.php';
require_once KIT_ROOT . '/kit_src/Support_tmp/Output.php';

// ── Watermark ─────────────────────────────────────────────────
echo "\n\033[1;36m   __  __   _   ___ ___  _____   __  \033[0m\n";
echo "\033[1;36m  |  \/  | /_\ | _ \   \| __\ \ / /  \033[0m\n";
echo "\033[1;36m  | |\/| |/ _ \|   / |) | _| \ V /   \033[0m\n";
echo "\033[1;36m  |_|  |_/_/ \_\_|_\___/|___| \_/    \033[0m\n";
echo "  \033[1;35mMARDEV — The Lightweight Vanilla PHP MVC Engine\033[0m\n";

// ── Resolve command ───────────────────────────────────────────
$argv = $_SERVER['argv'] ?? [];
$cmd  = $argv[1] ?? 'help';
$arg1 = $argv[2] ?? null;
$arg2 = $argv[3] ?? null;

// ── Map command to file ───────────────────────────────────────
$map = [
    'help'            => 'help',
    'db:seed'         => 'db/seed',
    'db:fresh'        => 'db/fresh',
    'db:migrate'      => 'db/migrate',
    'migrate'         => 'db/migrate',
    'migrate:rollback'=> 'db/rollback',
    'make:controller' => 'make/controller',
    'make:model'      => 'make/model',
    'make:view'       => 'make/view',
    'make:middleware' => 'make/middleware',
    'make:migration'  => 'make/migration',
    'make:auth'       => 'make/auth',
    'route:list'      => 'route/list',
    'route:test'      => 'route/test',
    'serve'           => 'serve',
    'key:generate'    => 'key/generate',
    'tinker'          => 'tinker',
    'cache:clear'     => 'system/cache_clear',
    'logs:clear'      => 'system/logs_clear',
    'optimize:clear'  => 'system/optimize_clear',
    'env:setup'       => 'system/env_setup',
];

$file = isset($map[$cmd])
    ? KIT_ROOT . '/kit_src/Commands_tmp/' . $map[$cmd] . '.php'
    : null;

if (!$file || !file_exists($file)) {
    Output::error("Unknown command: {$cmd}");
    Output::line('Run  php kit help  to see available commands.');
    exit(1);
}

require_once $file;
