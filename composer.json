{
    "name": "mardev/starter-kit",
    "description": "Starter Kit — PHP MVC Boilerplate",
    "license": "MIT",
    "type": "project",
    "bin": [
        "kit-new",
        "kit-new.bat"
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "Setup\\": "kit_src/Setup/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "Setup\\Installer::install",
            "php -r \"@copy('.env.example', '.env');\"",
            "php kit env:setup",
            "php kit key:generate",
            "php kit db:seed"
        ],
        "test":         "phpunit",
        "test:unit":    "phpunit --testsuite Unit",
        "test:feature": "phpunit --testsuite Feature",
        "kit":          "php kit"
    },
    "require": {
        "phpmailer/phpmailer": "^7.1"
    }
}
